<!-- The stock jar-with-dependencies descriptor, plus the JPEG 2000 decoder's licence texts: the
     unpacked jars' own META-INF/LICENSE and NOTICE files collide, and the OpenJPEG (BSD-2) notice
     must go with every copy of the decoder. -->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 https://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>jar-with-dependencies</id>
    <formats>
        <format>jar</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <!-- several jars register ImageIO plug-ins (TIFF, JBIG2, JPEG 2000); merge their service files
         rather than keep only the first -->
    <containerDescriptorHandlers>
        <containerDescriptorHandler>
            <handlerName>metaInf-services</handlerName>
        </containerDescriptorHandler>
    </containerDescriptorHandlers>
    <dependencySets>
        <dependencySet>
            <outputDirectory>/</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
            <unpack>true</unpack>
            <scope>runtime</scope>
        </dependencySet>
    </dependencySets>
    <fileSets>
        <fileSet>
            <directory>${project.basedir}/../../licenses</directory>
            <outputDirectory>META-INF/licenses</outputDirectory>
            <includes>
                <include>jpx-imageio-*</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
