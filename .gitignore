# Gradle build output (exclude)
/.gradle/
/build/
**/build/
**/target/

# Test output (exclude)
**/src/test/out/

# IDE files (exclude)
/.idea/
*.iml

# Local benchmark corpus (exclude)
# Large PDFs used by ParsingBenchmark, kept out of the repo: GitHub rejects any
# file over 100MB and this corpus runs to several hundred.
core/core-awt/src/test/resources/benchmark/

# Test-generated keystore (exclude)
# SigningTest calls PfxGenerator.createPfx to write this before each run, so it is a build artifact
# with fresh key material every time, not a fixture.
viewer/viewer-awt/src/test/resources/signing/certificate.pfx

# Flattened poms (exclude)
# flatten-maven-plugin writes one per module at process-resources, so any mvn build past that phase
# leaves 31 of them in the tree. Its flatten.clean execution removes them on mvn clean, but they are
# present for the whole of a build-and-test run.
**/.flattened-pom.xml
